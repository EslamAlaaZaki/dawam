      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Forgot Password",
        "description": "Email a password reset link, valid 30 minutes, to the user with this email (or\nkeep it for an admin to share when SMTP is off). The answer is the same whether or\nnot the email belongs to a user, and comes before any email is sent, so neither its\ncontent nor its timing tells.",
        "operationId": "forgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
