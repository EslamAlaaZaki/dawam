          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "description": "Code-specific extras; may be empty."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
