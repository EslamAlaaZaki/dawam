      "SmtpSettingsIn": {
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 255,
            "title": "Host"
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port"
          },
          "security": {
            "type": "string",
            "enum": [
              "none",
              "starttls",
              "tls"
            ],
            "title": "Security",
            "description": "`none`: plain SMTP; `starttls`: upgrade after connecting (usually port 587); `tls`: TLS from the start (usually 465). Certificates are verified."
          },
          "username": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Leave empty for a server without sign-in."
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Leave out to keep the saved password; `null` removes it. Changing the host, port or username needs it entered again."
          },
          "sender": {
            "type": "string",
            "maxLength": 320,
            "title": "Sender",
            "description": "The From address."
          }
        },
        "type": "object",
        "required": [
          "host",
          "port",
          "security",
          "sender"
        ],
        "title": "SmtpSettingsIn"
      },
