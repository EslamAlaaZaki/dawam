# Environment for the app and worker when DAWAM runs without Docker (systemd units in
# deploy/host/systemd/ read it from /etc/dawam/dawam.env). Only what differs from
# Compose is here; every other DAWAM_* setting, with its meaning and default, is in
# the repository's .env.example and can be added to this file the same way.
# Keep this file readable by root and the dawam user only (chmod 640): it holds secrets.

# REQUIRED. Generate once per installation and back it up:
#   openssl rand -base64 32
DAWAM_ENCRYPTION_KEY=

# REQUIRED outside Compose: the metadata database (PostgreSQL 16 with pgvector).
DAWAM_DATABASE_URL=postgresql+psycopg://dawam:change-me@127.0.0.1:5432/dawam

# Where uploaded files live. The default (data/files) is relative to the working
# directory; use an absolute path the dawam user can write.
DAWAM_STORAGE_BACKEND=local
DAWAM_STORAGE_PATH=/var/lib/dawam/files

# The address users open DAWAM at; every emailed link starts with it.
DAWAM_PUBLIC_URL=http://localhost:8080

# The only hop the app believes X-Forwarded-For / X-Forwarded-Proto from: nginx on
# the same host (the default).
DAWAM_FORWARDED_ALLOW_IPS=127.0.0.1

# First admin, created on the first start when no admin exists. Remove afterwards.
# DAWAM_ADMIN_EMAIL=admin@example.com
# DAWAM_ADMIN_PASSWORD=change-me-to-something-long

DAWAM_LOG_LEVEL=INFO
