# Copy to .env and adjust. Every setting but DAWAM_ENCRYPTION_KEY is optional. A
# value set below is the default used when the variable is not set; a commented-out
# line has no fixed default, and its comment says what happens when it is unset.
# Never commit your .env.

# --- PostgreSQL (the `db` service) -------------------------------------------
POSTGRES_USER=dawam
# Change this for any installation reachable by others.
POSTGRES_PASSWORD=dawam
POSTGRES_DB=dawam

# --- DAWAM (the `app` and `worker` services) ---------------------------------
# REQUIRED, no default: DAWAM does not start without it. The key that encrypts the
# credentials DAWAM stores (AES-256-GCM): 32 random bytes, base64-encoded. Generate
# one for each installation, keep it secret and back it up; stored credentials
# cannot be read without it. Generate it with
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# or: openssl rand -base64 32
DAWAM_ENCRYPTION_KEY=

# Host port the app (API + web UI) is published on.
DAWAM_PORT=8000

# SQLAlchemy URL of the metadata database. By default it is built from the
# POSTGRES_* values above and points at the `db` service; set it only to use an
# external PostgreSQL 16 server.
# DAWAM_DATABASE_URL=postgresql+psycopg://dawam:dawam@db:5432/dawam

# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
DAWAM_LOG_LEVEL=INFO

# Apply database migrations when the app starts (true/false).
DAWAM_RUN_MIGRATIONS_ON_STARTUP=true

# How often the worker polls for work, in seconds.
DAWAM_WORKER_POLL_SECONDS=5

# Directory with the built web UI, served at /. Unset by default, so only the API
# runs. The Docker image sets it to the frontend it ships (the value shown below),
# so leave it out of .env there; outside Docker, point it at frontend/dist (after
# `npm run build`) to serve both.
# DAWAM_FRONTEND_DIST=/app/frontend

# --- HTTPS (when DAWAM runs behind a TLS-terminating reverse proxy) ----------
# Strict-Transport-Security max-age in seconds (default: one year). The header is
# sent only on requests that arrived over HTTPS; 0 never sends it.
DAWAM_HSTS_MAX_AGE_SECONDS=31536000

# Addresses of the reverse proxies whose X-Forwarded-Proto / X-Forwarded-For
# headers are trusted: comma-separated IPs or networks (e.g. 172.16.0.0/12), or *
# to trust any (only if the app port is reachable through the proxy alone).
# Requests from other addresses count as plain HTTP, so they never get HSTS.
DAWAM_FORWARDED_ALLOW_IPS=127.0.0.1
