# Copy to .env and adjust. Every setting but DAWAM_ENCRYPTION_KEY is optional. A
# value set below is the default used when the variable is not set; a commented-out
# line has no fixed default, and its comment says what happens when it is unset.
# Never commit your .env.

# --- PostgreSQL (the `db` service) -------------------------------------------
POSTGRES_USER=dawam
# Change this for any installation reachable by others.
POSTGRES_PASSWORD=dawam
POSTGRES_DB=dawam

# --- DAWAM (the `app` and `worker` services) ---------------------------------
# `app` and `worker` read the DAWAM_* settings in this file. The other services
# get only what they need: `web` (the Next.js UI) DAWAM_HSTS_MAX_AGE_SECONDS, and
# `edge` (the nginx entry point) DAWAM_TRUSTED_PROXY_CIDRS. Neither holds secrets.

# REQUIRED, no default: DAWAM does not start without it. The key that encrypts the
# credentials DAWAM stores (AES-256-GCM): 32 random bytes, base64-encoded. Generate
# one for each installation, keep it secret and back it up; stored credentials
# cannot be read without it. Generate it with
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# or: openssl rand -base64 32
DAWAM_ENCRYPTION_KEY=


# SQLAlchemy URL of the metadata database. By default it is built from the
# POSTGRES_* values above and points at the `db` service; set it only to use an
# external PostgreSQL 16 server.
# DAWAM_DATABASE_URL=postgresql+psycopg://dawam:dawam@db:5432/dawam

# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
DAWAM_LOG_LEVEL=INFO

# Apply database migrations when the app starts (true/false).
DAWAM_RUN_MIGRATIONS_ON_STARTUP=true

# How often the worker polls for work, in seconds.
DAWAM_WORKER_POLL_SECONDS=5

# --- First admin --------------------------------------------------------------
# The spec's ADMIN_EMAIL / ADMIN_PASSWORD, with the DAWAM_ prefix every setting
# here uses. Set both or neither. When the app starts and no admin exists yet, it
# creates an admin (display name "Administrator") with this email and password.
# Once an admin exists, later starts never create or change one, whatever these
# say, so you can remove them after the first start. Unset (or empty) by default:
# no admin is created. While no admin exists, startup fails, naming the variable,
# if only one of the two is set, the email is not an email address, the password
# is shorter than 10 or longer than 1024 characters, or a non-admin user already
# has this email (that user is never changed). Once an admin exists, these values
# are not checked at all.
# DAWAM_ADMIN_EMAIL=admin@example.com
# DAWAM_ADMIN_PASSWORD=change-me-to-something-long

# --- Sessions -----------------------------------------------------------------
# A session ends after this many hours without a request (decimals allowed)...
DAWAM_SESSION_IDLE_TIMEOUT_HOURS=8
# ...and this many days after sign-in, however active it is.
DAWAM_SESSION_ABSOLUTE_TIMEOUT_DAYS=14
# Session and CSRF cookies are marked Secure when a request arrives over HTTPS
# (behind a TLS-terminating proxy, see DAWAM_FORWARDED_ALLOW_IPS below).

# --- Sign-in protection -------------------------------------------------------
# After this many consecutive failed sign-ins an account is locked (even the right
# password is refused)...
DAWAM_LOGIN_MAX_FAILURES=5
# ...for this many minutes (decimals allowed). A successful sign-in resets the count.
DAWAM_LOGIN_LOCKOUT_MINUTES=15
# A client address with this many failed sign-ins (on any accounts) within the
# window below must wait until the oldest is older than the window. Users behind one
# shared address (NAT) share this limit.
DAWAM_LOGIN_IP_MAX_FAILURES=20
DAWAM_LOGIN_IP_WINDOW_MINUTES=15

# --- The entry point (the `edge` service) -------------------------------------
# Host port DAWAM is published on: the `edge` nginx proxy, which sends /api/,
# /healthz and /readyz to `app` and everything else to `web`. It is the only
# published port.
DAWAM_PORT=8000

# --- HTTPS (when DAWAM runs behind a TLS-terminating reverse proxy) ----------
# `edge` is the one hop the app trusts: it always overwrites X-Forwarded-For and
# X-Forwarded-Proto, so whatever a client sends in them is ignored. Compose sets
# DAWAM_FORWARDED_ALLOW_IPS to edge's fixed address (see compose.yaml); outside
# Compose it defaults to 127.0.0.1.
#
# To put a TLS-terminating proxy in front of DAWAM_PORT, list its addresses here
# (comma-separated IPs or networks). From those addresses only, `edge` takes the
# client from X-Forwarded-For (the right-most entry not in this list) and the scheme
# from X-Forwarded-Proto, so the proxy must append to the first and set the second.
# Requests that arrived over HTTPS then get HSTS and Secure cookies. Unset by
# default: no proxy is trusted, and every request counts as plain HTTP.
# DAWAM_TRUSTED_PROXY_CIDRS=10.0.0.5

# Strict-Transport-Security max-age in seconds (default: one year), used by both
# `app` (API responses) and `web` (pages). The header is sent only on requests
# that arrived over HTTPS; 0 never sends it.
DAWAM_HSTS_MAX_AGE_SECONDS=31536000
