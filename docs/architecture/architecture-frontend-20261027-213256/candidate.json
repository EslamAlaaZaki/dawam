  "cards": [
    {
      "dot": "cyan",
      "title": "Kinds of arrows",
      "items": [
        "Solid: runtime (render tree in the browser, or HTTP from the browser to FastAPI).",
        "Dashed: generated contract at build time. backend → openapi.json comes from python -m dawam openapi; schema.d.ts from npm run generate:api. No runtime web → app call.",
        "Every screen reaches the backend only through src/api hooks and the one client (no other fetch call found in src)."
      ]
    },
    {
      "dot": "rose",
      "title": "Authentication flow",
      "items": [
        "Session is the backend's httpOnly dawam_session cookie; the browser never reads it.",
        "RequireSignIn: GET /api/v1/me; null (401) → /login?from=…; must_change_password → /change-password.",
        "Mutations add X-CSRF-Token from the dawam_csrf cookie (double submit).",
        "Server-side page renders never call the API (client.ts comment, baseUrl \"\" on the server)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Routes (app/)",
      "items": [
        "Public: /login, /signup, /forgot-password, /reset-password, /accept-invitation.",
        "(signed-in): /, /profile, /change-password, /workspaces/[workspaceId], /workspaces/[workspaceId]/change-sets/[changeSetId].",
        "(signed-in)/admin: ai-runs, email (+ links), invitations, llm (+ document-ai, settings), security-events, settings, users, web, workspaces."
      ]
    },
    {
      "dot": "amber",
      "title": "Configuration-dependent or uncertain",
      "items": [
        "next dev only: next.config.ts rewrites /api/*, /healthz, /readyz to DAWAM_DEV_API_URL; in production edge routes them.",
        "Admin-page access is enforced by the backend; whether the UI hides admin links by role was not traced.",
        "Panels inside WorkspacePage are selected by the folder tree; each panel's exact API calls are in its src/api module, not listed here."
      ]
    }
  ]
