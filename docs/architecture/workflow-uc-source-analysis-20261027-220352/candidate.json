  "cards": [
    {
      "dot": "cyan",
      "title": "User story",
      "items": [
        "As an analyst I want to understand an undocumented source system, so that I can design the warehouse on facts.",
        "Actions: add a Connection (or import the schema from files), extract, then run profiling, a PII scan and relationship inference, and review what they suggest.",
        "Outcome: a versioned Source Schema (Snapshots) with profiles, PII findings and accepted relationships; the warehouse staging follows automatically."
      ]
    },
    {
      "dot": "emerald",
      "title": "System behaviour (verified)",
      "items": [
        "Owners/editors only; the password is sealed with AES-256-GCM and never returned.",
        "Extraction runs in the worker, outside any app-database transaction; a Snapshot is written only if something changed.",
        "A new Snapshot triggers a staging-sync Change Set and a regeneration offer (wiring.py).",
        "Analysis jobs need a live Connection; imported systems cannot be profiled or scanned."
      ]
    },
    {
      "dot": "rose",
      "title": "Errors and branches",
      "items": [
        "Connection test failure returns ok=false with a safe message (no host, user or driver text).",
        "Start extraction without a Connection: 409.",
        "Import file with errors, or with warnings not accepted: nothing is written.",
        "PII findings and relationships stay suggested until a member accepts or rejects them; a later run never undoes a decision."
      ]
    },
    {
      "dot": "amber",
      "title": "Simplified",
      "items": [
        "Analysis jobs read sample rows from the source DB too (not drawn to keep one source arrow).",
        "AI help (descriptions, gaps report) through the assistant is in the AI diagrams."
      ]
    }
  ]
